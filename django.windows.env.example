SECRET_KEY=change-me
SIGNING_KEY=change-me-too
DEBUG=0
PRODUCTION=1

DJANGO_ALLOWED_HOSTS=scorecore.example.local,localhost,127.0.0.1
ALLOWED_ORIGINS=https://scorecore.example.local,http://localhost:3000
PROTOCOL=https

DB_ENGINE=mssql
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=scorecore
MSSQL_USER=scorecore_user
MSSQL_PASSWORD=change-me
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_EXTRA_PARAMS=TrustServerCertificate=yes;

USE_REDIS=0
DOCKER_FEATURE_ENABLED=0

MEDIA_ROOT=C:\scorecore\media
STATIC_ROOT=C:\scorecore\static
DEFAULT_DIRS=projects,backup,evaluations,setup,logs,videos

SESSION_COOKIE_SECURE=1
SECURE_REFERRER_POLICY=same-origin
SECURE_HSTS_SECONDS=0
SECURE_HSTS_PRELOAD=0
SECURE_SSL_REDIRECT=0
USE_X_FORWARDED_HOST=1

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.local
DJANGO_SUPERUSER_PASSWORD=change-me
